# Firma Digital — raíz pública del dominio (SPA Angular + API Laravel en /api).
Options -Indexes -MultiViews
DirectoryIndex index.html
AddType application/javascript .mjs
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Siempre HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Encabezado Authorization para la API (inicio de sesión futuro)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # /api/* → Laravel
    RewriteRule ^api(/.*)?$ laravel.php [L,QSA]

    # Archivos y carpetas existentes (js, css, pdf.js, descargas…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra ruta es de la SPA (/firmar, /historial…): la resuelve Angular
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # El front solo habla con su propio dominio y con el agente local de la PC del usuario.
    # (La API ya envía su propia política más estricta; "setifempty" no la reemplaza.)
    Header always setifempty Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:9876 http://localhost:9876; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # Caché: index.html siempre fresco; archivos con hash en el nombre, un año.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "-[A-Za-z0-9_]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Nunca servir archivos ocultos (.env, .git…) ni respaldos
<FilesMatch "(^\.|\.(bak|old|sql|sqlite|log|env)$)">
    Require all denied
</FilesMatch>
